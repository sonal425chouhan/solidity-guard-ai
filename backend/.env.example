PORT=3001
# Hardhat local development accounts only. No wallet extension or real funds.
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_SIGNER_INDEX=0
# Optional: includeAi defaults to false for every request.
# includeAi=true consents to sending bounded findings/snippets to Groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_MS=15000
